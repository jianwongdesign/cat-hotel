  "narrative": {
    "northStar": "A contemporary cat-hotel showroom",
    "overview": "Warm white, espresso-plum and clay frame substantial real photography. Rounded humanist headings, compact content groupings and confident colour give the cosy boutique identity more presence. Controls are inset, approachable and easy to find; imagery carries the setting without decorative sticker badges.\n\nThis source-derived record supersedes the previous restrained Newsreader/DM Sans design, which the user rejected as too plain and empty. It captures `src/styles.css`, `src/app.js` and `src/video.js` on 28 October 2026. Product truth belongs to `PRODUCT.md`; the homepage composition and direction belong to `.impeccable/surfaces/index-html.md`. The implementation remains a design and booking/payment preview. No inventory, reservation holds, payment collection or confirmation emails are connected.",
    "keyCharacteristics": [
      "Warm white surfaces, plum chapters, clay backgrounds and rust actions.",
      "Gabarito headings with Albert Sans body and control text.",
      "Substantial room photography, visible capacity/rates and close content grouping.",
      "Rounded inset controls, a native desktop paw cursor and touch-ready layouts.",
      "A controlled atmosphere film and explicit preview notices."
    ],
    "rules": [
      {
        "name": "The Contrast Rule",
        "body": "Use the rust focus outline on pale surfaces, warm white on the hero and rust contact section, and peach on the care chapter action.",
        "section": "colors"
      },
      {
        "name": "The Purposeful Depth Rule",
        "body": "Use elevation to clarify the reservation desk, modal layer and selected room; retain open catalogue text and stationary cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use Gabarito, Albert Sans, warm white, plum, rust and clay as the current implemented identity.",
      "**Do** keep actual room photographs, capacity and rates prominent and close together.",
      "**Do** preserve visible focus, native controls, film controls and fine-pointer-only paw cursors.",
      "**Do** keep AI atmosphere footage distinct from actual room photography.",
      "**Do** retain explicit preview notices throughout booking and payment states."
    ],
    "donts": [
      "**Don't** restore the superseded sparse Newsreader/DM Sans aesthetic.",
      "**Don't** add decorative sticker badges, cursor followers or trailing animations.",
      "**Don't** turn the open catalogue into floating cards or add hover lifts and scroll reveals.",
      "**Don't** invent reviews, live availability, reservation success or payment collection.",
      "**Don't** describe source-reviewed preference behaviour as runtime verified."
    ]
  }
}
